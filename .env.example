# Copy this file to .env and fill in your own codesigning identity.
# .env is gitignored, so your identity never gets committed.
#
# Find your available identities with:
#   security find-identity -v -p codesigning
#
# Then set the exact name (or SHA-1 hash, if the name is ambiguous):
CODESIGN_IDENTITY=Apple Development: you@example.com (TEAMID)
